# =============================================================================
# LAMIKAA NATURALS — Development Environment Configuration
# =============================================================================
#
# Two API modes, selected by the pair below:
#
#   MOCK  (the committed default)  JSON Server over db.json on :3001.
#         REACT_APP_API_URL=http://localhost:3001
#         REACT_APP_USE_MOCK_API=true
#         Run: npm run dev   (starts the storefront and the mock API together)
#
#   LIVE  the Laravel API on Cloudways (https://core.lamikanaturals.com/api/v1).
#         Uncomment the live block below and comment out the mock one. Every
#         storefront and admin request then hits that server and its MySQL
#         database — there is no mock data in this mode.
#
# Restart the dev server after ANY change to this file.
#
# To verify the live API end to end (writes to the real database!):
#   npm run test:live
#
# IMPORTANT: Never commit credentials to version control.
# =============================================================================

# API Configuration - JSON Server for local development
REACT_APP_API_URL=http://localhost:3001
REACT_APP_USE_MOCK_API=true

# API Configuration - Live Laravel + MySQL server (Cloudways)
# REACT_APP_API_URL=https://core.lamikanaturals.com/api/v1
# REACT_APP_USE_MOCK_API=false


# Feature Flags
REACT_APP_ENABLE_ANALYTICS=false

# Build Configuration
GENERATE_SOURCEMAP=true

# Payment Gateway (for production - Razorpay)
# REACT_APP_RAZORPAY_KEY_ID=your_razorpay_key_id

# Shiprocket (for production)
# REACT_APP_SHIPROCKET_EMAIL=your_shiprocket_email
