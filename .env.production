# =============================================================================
# LAMIKAA NATURALS — Production Environment Configuration
# =============================================================================
#
# These values are embedded at build time when running 'npm run build'.
# The store's identity (name, tagline, description, logo) is NOT here: it lives
# in src/config/brand.js.
#
# IMPORTANT: Never commit sensitive credentials to version control.
# =============================================================================

# API Configuration
# -----------------
# The Cloudways Laravel backend API URL
REACT_APP_API_URL=https://core.lamikanaturals.com/api/v1

# Set to "false" to use the production API (not the mock JSON Server)
REACT_APP_USE_MOCK_API=false

# Feature Flags
# -------------
REACT_APP_ENABLE_ANALYTICS=true

# Build Configuration
# -------------------
# Generates source maps for production (set to false to reduce bundle size)
GENERATE_SOURCEMAP=false
