# =============================================================================
# LAMIKAA NATURALS — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values.
#
# The store's name, tagline and description are NOT environment variables: they
# live in src/config/brand.js, the single source of brand truth.
#
# IMPORTANT: Never commit .env files with credentials to version control.
# =============================================================================

# --- API CONFIGURATION ---
# Local development against JSON Server (npm run dev):
REACT_APP_API_URL=http://localhost:3001
REACT_APP_USE_MOCK_API=true

# Live Laravel API on Cloudways (every request hits the real database):
# REACT_APP_API_URL=https://core.lamikanaturals.com/api/v1
# REACT_APP_USE_MOCK_API=false

# --- FEATURES ---
REACT_APP_ENABLE_ANALYTICS=false
GENERATE_SOURCEMAP=true

# --- PAYMENT GATEWAYS (production only) ---
# REACT_APP_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
# REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxx

# --- SHIPPING (production only) ---
# REACT_APP_SHIPROCKET_EMAIL=admin@yourstore.com
